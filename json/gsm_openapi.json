{
  "openapi": "3.1.0",
  "info": {
    "title": "GSM API",
    "version": "0.1.0",
    "description": "Genius Software Manager (GSM) REST API for AI-assisted software delivery management. Captures human-supervised AI coding agent workflows (jobs), agent output and git artifacts (evidence), human supervision decisions (reviews), and produces cryptographically signed client-facing delivery reports."
  },
  "servers": [
    {
      "url": "http://localhost:8787",
      "description": "Local development server"
    },
    {
      "url": "https://gsm.example.com",
      "description": "Production (via Cloudflare Tunnel)"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Jobs",
      "description": "AI-assisted software delivery jobs"
    },
    {
      "name": "Evidence",
      "description": "Agent output, git diffs, and commits captured as evidence"
    },
    {
      "name": "Reviews",
      "description": "Human supervision decisions (approve, reject, flag)"
    },
    {
      "name": "Reports",
      "description": "Ed25519-signed proof reports"
    }
  ],
  "paths": {
    "/api/v1/jobs": {
      "get": {
        "tags": ["Jobs"],
        "summary": "List all jobs",
        "operationId": "listJobs",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/JobStatus"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of jobs",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Job"
                      }
                    },
                    "limit": { "type": "integer" },
                    "offset": { "type": "integer" },
                    "total": { "type": "integer" }
                  },
                  "required": ["data", "limit", "offset", "total"]
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Jobs"],
        "summary": "Create a new job",
        "operationId": "createJob",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JobCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Job created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/jobs/{jobId}": {
      "parameters": [
        {
          "name": "jobId",
          "in": "path",
          "required": true,
          "schema": { "type": "string", "format": "uuid" }
        }
      ],
      "get": {
        "tags": ["Jobs"],
        "summary": "Get a single job by ID",
        "operationId": "getJob",
        "responses": {
          "200": {
            "description": "Job details",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Job" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "patch": {
        "tags": ["Jobs"],
        "summary": "Update job status or metadata",
        "operationId": "updateJob",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/JobUpdate" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated job",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Job" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "tags": ["Jobs"],
        "summary": "Delete a job",
        "operationId": "deleteJob",
        "responses": {
          "204": { "description": "Job deleted" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/v1/jobs/{jobId}/evidence": {
      "parameters": [
        {
          "name": "jobId",
          "in": "path",
          "required": true,
          "schema": { "type": "string", "format": "uuid" }
        }
      ],
      "get": {
        "tags": ["Evidence"],
        "summary": "List evidence events for a job",
        "operationId": "listEvidence",
        "responses": {
          "200": {
            "description": "Paginated evidence list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Evidence" }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/evidence/{evidenceId}": {
      "parameters": [
        {
          "name": "evidenceId",
          "in": "path",
          "required": true,
          "schema": { "type": "string", "format": "uuid" }
        }
      ],
      "get": {
        "tags": ["Evidence"],
        "summary": "Get a single evidence record",
        "operationId": "getEvidence",
        "responses": {
          "200": {
            "description": "Evidence record",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Evidence" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/v1/jobs/{jobId}/reviews": {
      "parameters": [
        {
          "name": "jobId",
          "in": "path",
          "required": true,
          "schema": { "type": "string", "format": "uuid" }
        }
      ],
      "post": {
        "tags": ["Reviews"],
        "summary": "Record a review decision",
        "operationId": "createReview",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ReviewCreate" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Review recorded",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Review" }
              }
            }
          }
        }
      },
      "get": {
        "tags": ["Reviews"],
        "summary": "List reviews for a job",
        "operationId": "listReviews",
        "responses": {
          "200": {
            "description": "List of reviews",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Review" }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/jobs/{jobId}/reports": {
      "parameters": [
        {
          "name": "jobId",
          "in": "path",
          "required": true,
          "schema": { "type": "string", "format": "uuid" }
        }
      ],
      "post": {
        "tags": ["Reports"],
        "summary": "Generate a signed proof report",
        "operationId": "createReport",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ReportCreate" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Report generated and signed",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Report" }
              }
            }
          }
        }
      }
    },
    "/api/v1/reports/{reportId}": {
      "parameters": [
        {
          "name": "reportId",
          "in": "path",
          "required": true,
          "schema": { "type": "string", "format": "uuid" }
        }
      ],
      "get": {
        "tags": ["Reports"],
        "summary": "Get a published report",
        "operationId": "getReport",
        "responses": {
          "200": {
            "description": "Published report",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Report" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "responses": {
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" }
        },
        "required": ["code", "message"]
      },
      "JobStatus": {
        "type": "string",
        "enum": ["queued", "in_progress", "awaiting_review", "approved", "rejected", "reported", "failed"]
      },
      "Job": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "title": { "type": "string" },
          "repo_url": { "type": "string", "format": "uri" },
          "base_ref": { "type": "string" },
          "head_ref": { "type": "string" },
          "status": { "$ref": "#/components/schemas/JobStatus" },
          "agent": { "type": "string", "description": "Coding agent identifier, e.g. 'claude-code'" },
          "supervisor": { "type": "string", "description": "Human supervisor identifier" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "title", "repo_url", "status", "created_at", "updated_at"]
      },
      "JobCreate": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "repo_url": { "type": "string", "format": "uri" },
          "base_ref": { "type": "string" },
          "head_ref": { "type": "string" },
          "agent": { "type": "string" },
          "supervisor": { "type": "string" }
        },
        "required": ["title", "repo_url"]
      },
      "JobUpdate": {
        "type": "object",
        "properties": {
          "status": { "$ref": "#/components/schemas/JobStatus" },
          "head_ref": { "type": "string" },
          "supervisor": { "type": "string" }
        }
      },
      "EvidenceKind": {
        "type": "string",
        "enum": ["agent_log", "git_diff", "commit", "test_result", "build_log", "artifact"]
      },
      "Evidence": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "job_id": { "type": "string", "format": "uuid" },
          "kind": { "$ref": "#/components/schemas/EvidenceKind" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "payload_path": { "type": "string", "description": "Local filesystem path to evidence artifact" },
          "metadata": { "type": "object" },
          "captured_at": { "type": "string", "format": "date-time" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "job_id", "kind", "sha256", "created_at", "updated_at"]
      },
      "ReviewDecision": {
        "type": "string",
        "enum": ["approve", "reject", "flag"]
      },
      "Review": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "job_id": { "type": "string", "format": "uuid" },
          "decision": { "$ref": "#/components/schemas/ReviewDecision" },
          "reviewer": { "type": "string" },
          "comment": { "type": "string" },
          "evidence_ids": {
            "type": "array",
            "items": { "type": "string", "format": "uuid" }
          },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "job_id", "decision", "reviewer", "created_at", "updated_at"]
      },
      "ReviewCreate": {
        "type": "object",
        "properties": {
          "decision": { "$ref": "#/components/schemas/ReviewDecision" },
          "reviewer": { "type": "string" },
          "comment": { "type": "string" },
          "evidence_ids": {
            "type": "array",
            "items": { "type": "string", "format": "uuid" }
          }
        },
        "required": ["decision", "reviewer"]
      },
      "ReportStatus": {
        "type": "string",
        "enum": ["draft", "signed", "published", "revoked"]
      },
      "Report": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "job_id": { "type": "string", "format": "uuid" },
          "status": { "$ref": "#/components/schemas/ReportStatus" },
          "manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "signature": { "type": "string", "description": "Ed25519 signature (base64) over the canonicalized manifest" },
          "signing_key_id": { "type": "string" },
          "evidence_ids": {
            "type": "array",
            "items": { "type": "string", "format": "uuid" }
          },
          "review_ids": {
            "type": "array",
            "items": { "type": "string", "format": "uuid" }
          },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "job_id", "status", "manifest_sha256", "created_at", "updated_at"]
      },
      "ReportCreate": {
        "type": "object",
        "properties": {
          "evidence_ids": {
            "type": "array",
            "items": { "type": "string", "format": "uuid" }
          },
          "review_ids": {
            "type": "array",
            "items": { "type": "string", "format": "uuid" }
          }
        }
      }
    }
  }
}
